  },
  "dependencies": {
    "@gumlet/player.js": "^2.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "esbuild": "^0.25.0",
    "react": ">=15.0.1",
    "react-dom": ">=15.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
