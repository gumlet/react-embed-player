{
  "name": "@gumlet/react-embed-player",
  "version": "2.1.0",
  "description": "Gumlet React Embed Player",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/gumlet/react-embed-player.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome lint ./src",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@gumlet/player.js": "^3.0.3"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  }
}
